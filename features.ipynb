    "\n",
    "def segmentar_latido(senal, pico, ventana):\n",
    "    #Cortar un solo latido\n",
    "    inicio = pico - ventana\n",
    "    fin = pico + ventana\n",
    "    if(inicio < 0):\n",
    "        inicio = 0\n",
    "    if(fin > len(senal)):\n",
    "        fin = len(senal)\n",
